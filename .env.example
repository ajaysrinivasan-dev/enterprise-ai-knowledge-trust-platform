EAKTP_APP_NAME=Enterprise AI Knowledge & Trust Platform
EAKTP_ENVIRONMENT=development
EAKTP_LOG_LEVEL=INFO
# Administrator key: required in production-like environments; random secret >= 32 characters.
EAKTP_API_KEY=
# Optional role keys. Use distinct random secrets (>= 32 characters); blank disables that role key.
EAKTP_READ_API_KEY=
EAKTP_WRITE_API_KEY=
EAKTP_API_HOST=127.0.0.1
EAKTP_API_PORT=8000
EAKTP_CORS_ORIGINS=http://localhost:8501
EAKTP_MAX_UPLOAD_BYTES=10485760
EAKTP_OLLAMA_BASE_URL=http://localhost:11434
EAKTP_OLLAMA_MODEL=
EAKTP_OLLAMA_TIMEOUT_SECONDS=30
EAKTP_EMBEDDING_BACKEND=hash
EAKTP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EAKTP_VECTOR_BACKEND=sqlite
EAKTP_SQLITE_VECTOR_PATH=data/runtime/eaktp.sqlite3
EAKTP_CHROMA_PATH=data/runtime/chroma
EAKTP_EVALUATION_DATABASE=data/runtime/evaluation.db
